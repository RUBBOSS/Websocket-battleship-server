{  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },  "include": ["src/**/*", "front/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}